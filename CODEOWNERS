# CI signs whatever lands on main, and that signature is what makes muaz install
# a plugin without warning the user. Everything that can influence *what* gets
# signed is owned and reviewed.

/plugins/       @0xAMC
/scripts/       @0xAMC
/.github/       @0xAMC
/publisher.pub  @0xAMC
/yanked.json    @0xAMC
/CODEOWNERS     @0xAMC

# `index.json` and `index.json.minisig` are deliberately left unowned. They are
# generated by the publish workflow and opened as a pull request from the same
# job that holds the signing key, so requiring a code-owner review on them would
# deadlock every publish waiting for an approval that nobody can usefully give.
#
# Nothing is lost by that. Review cannot tell you whether an index is authentic —
# only the signature can, and clients check it over the raw bytes before parsing.
# A hand-pushed index is refused for having no valid signature, and a replayed
# old one is refused by the serial check.
